*.class
*.jar
*.war
*.nar
*.ear
hs_err_pid*
target/
*.ctxt
.mtj.tmp/

# === Node / Frontend ===
node_modules/
dist/
.nuxt/
.next/
.output/

# === Python ===
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# === Logs ===
*.log
logs/

# === IDE / OS ===
.idea/
.vscode/
*.swp
